# Narratoqo web needs no environment variables or secrets.
# Optional cloud-voice API keys are entered in the in-app Settings dialog and are
# kept in the browser session only. Do not add provider keys here.

# Optional AdMob IDs for native builds. Export the pair for the target platform.
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=
